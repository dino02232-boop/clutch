rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    /* 관리자 = 산도의 두 계정. 글·댓글을 남의 것도 지울 수 있는 유일한 자리다
       (pages.js 의 ADMIN_UIDS 와 같은 목록). */
    function isAdmin() {
      return signedIn() && request.auth.uid in ['xSLD6QapaAQIIQSsbDSYItjdFLX2', 'v5iaeJHK79bK5nRkSiDql3dcii03'];
    }
    function validUserCreate(uid) {
      return owner(uid)
        && request.resource.data.keys().hasOnly(['uid','displayName','nickname','photoURL','points','createdAt','weekProfit','totalProfit','winRate','maxOdds'])
        && request.resource.data.uid == uid
        && request.resource.data.points == 10000
        && request.resource.data.weekProfit == 0
        && request.resource.data.totalProfit == 0
        && request.resource.data.winRate == 0
        && request.resource.data.maxOdds == 0;
    }
    /* ── 1:1 쪽지 ─────────────────────────────────────────────
       받은 쪽지는 받는 사람의 inbox, 보낸 쪽지는 보낸 사람의 outbox 에 같은 내용으로 한 번에(batch)
       기록한다. 두 문서 모두 당사자만 읽을 수 있고, 고칠 수 있는 것은 받는 사람의 '읽음 표시'
       (readAt) 하나뿐이다. 스팸 방지는 ①자기 자신에게 보내기 금지 ②본문 500자 제한
       ③보낸 사람 문서의 lastMsgAt 을 같은 batch 에서 갱신하게 해 3초에 한 통으로 제한한다. */
    function msgBodyOk(data) {
      return data.keys().hasOnly(['fromUid','fromName','toUid','toName','body','createdAt','readAt'])
        && data.fromUid is string
        && data.toUid is string
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 500
        && data.fromName is string
        && data.fromName.size() > 0
        && data.fromName.size() <= 40
        && data.toName is string
        && data.toName.size() <= 40
        && data.createdAt == request.time
        && data.readAt == null;
    }
    // 같은 batch 에서 보낸 사람 users/{uid}.lastMsgAt 을 지금 시각으로 올려야 하고,
    // 그 직전 값은 3초 이상 지나 있어야 한다(연속 전송 제한).
    function msgThrottleOk(uid) {
      let prev = get(/databases/$(database)/documents/users/$(uid)).data;
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.lastMsgAt == request.time
        && (!('lastMsgAt' in prev) || prev.lastMsgAt <= request.time - duration.value(3, 's'));
    }
    function matchingNewBet(uid) {
      let bet = getAfter(/databases/$(database)/documents/bets/$(uid)/items/$(request.resource.data.lastBetId));
      return request.resource.data.lastBetId is string
        && bet.data.uid == uid
        && bet.data.status == 'open'
        && !exists(/databases/$(database)/documents/bets/$(uid)/items/$(request.resource.data.lastBetId))
        && bet.data.stake == request.resource.data.lastStake
        && request.resource.data.lastStake is int
        && request.resource.data.lastStake >= 100
        && request.resource.data.points == resource.data.points - request.resource.data.lastStake;
    }
    match /users/{uid} {
      allow read: if true;
      allow create: if validUserCreate(uid);
      allow update: if owner(uid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','lastBetId','lastStake'])
          && matchingNewBet(uid))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','supportAt'])
          && resource.data.points < 100
          && request.resource.data.points == resource.data.points + 1000
          && request.resource.data.supportAt == request.time
          && (!('supportAt' in resource.data) || resource.data.supportAt <= request.time - duration.value(24, 'h')))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 2
          && request.resource.data.nickname.size() <= 20)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMsgAt'])
          && request.resource.data.lastMsgAt == request.time)
      );
      allow delete: if false;

      /* ── 쪽지함 ────────────────────────────────────────────
         inbox: 받는 사람만 읽고, 보내는 사람이 자기 이름으로만 넣을 수 있다(자기 자신 제외).
         outbox: 보낸 사람만 읽고, 받는 사람은 readAt 만 바꿀 수 있다. */
      match /inbox/{msgId} {
        allow read: if owner(uid);
        allow create: if signedIn()
          && request.auth.uid != uid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == uid
          && msgBodyOk(request.resource.data)
          && msgThrottleOk(request.auth.uid);
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
      match /outbox/{msgId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.fromUid == uid
          && request.resource.data.toUid != uid
          && msgBodyOk(request.resource.data)
          && msgThrottleOk(uid);
        allow update: if signedIn()
          && request.auth.uid == resource.data.toUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
      /* 게시판 읽음 표시 — 그 사람만 읽고 쓰는 작은 문서 하나(읽은 글 ID 목록). */
      match /state/{docId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['ids','updatedAt'])
          && request.resource.data.ids is list
          && request.resource.data.ids.size() <= 500;
        allow delete: if owner(uid);
      }
    }
    match /bets/{uid}/items/{betId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'open'
        && request.resource.data.stake is int
        && request.resource.data.stake >= 100
        && request.resource.data.picks is list
        && request.resource.data.picks.size() >= 1
        && request.resource.data.picks.size() <= 20
        && request.resource.data.potential is int
        && request.resource.data.combinedOdds is number
        && request.resource.data.createdAt == request.time
        && request.resource.data.weekKey is string
        && request.resource.data.keys().hasOnly(['uid','stake','picks','combinedOdds','potential','status','createdAt','weekKey'])
        && !exists(/databases/$(database)/documents/bets/$(uid)/items/$(betId))
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.points == get(/databases/$(database)/documents/users/$(uid)).data.points - request.resource.data.stake
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastBetId == betId;
      allow update, delete: if false;
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 3000
        && request.resource.data.slip is list
        && request.resource.data.slip.size() <= 20
        && request.resource.data.keys().hasOnly(['uid','displayName','title','body','slip','createdAt']);
      /* ── 추천(👍) ─────────────────────────────────────────────
         로그인한 사람이 likedUids 에 자기 uid 하나만 더하거나 빼고, likeCount 는
         likedUids 길이와 같아야 한다. 제목·본문·글쓴이처럼 다른 필드나 남의 uid 는
         바꿀 수 없다. 추천 추가는 길이 +1 과 likeCount +1, 취소는 −1 쌍으로만 통과한다. */
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount','likedUids'])
        && request.resource.data.likedUids is list
        && request.resource.data.likedUids.size() <= 5000
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.likeCount == request.resource.data.likedUids.size()
        && (
          ( !(request.auth.uid in resource.data.get('likedUids', []))
            && request.resource.data.likedUids.size() == resource.data.get('likedUids', []).size() + 1
            && request.resource.data.likedUids.hasAll(resource.data.get('likedUids', []))
            && request.auth.uid in request.resource.data.likedUids
            && request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1 )
          ||
          ( request.auth.uid in resource.data.get('likedUids', [])
            && resource.data.get('likedUids', []).size() == request.resource.data.likedUids.size() + 1
            && resource.data.get('likedUids', []).hasAll(request.resource.data.likedUids)
            && !(request.auth.uid in request.resource.data.likedUids)
            && request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1 )
        );
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.keys().hasOnly(['uid','displayName','body','createdAt']);
        /* 댓글 삭제 — 댓글쓴이 본인, 관리자, 그리고 이 글의 글쓴이(글을 지우기 전에
           자기 글의 댓글을 정리할 수 있게). */
        allow delete: if isAdmin()
          || (signedIn() && (resource.data.uid == request.auth.uid
              || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid));
        allow update: if false;
      }
    }
  }
}
